# Copy to .env and fill in. Never commit the real file.
# .gitignore already excludes .env

# Shared secret proving a request came from our extension. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The same value goes in the extension's relay settings.
RELAY_TOKEN=

# The model key. This is the only place it exists.
PROVIDER_API_KEY=

# openai | gemini
PROVIDER=openai

# Optional. Defaults to gpt-5-mini for openai, gemini-3-flash for gemini.
PROVIDER_MODEL=

# Must match the installed extension ID exactly.
ALLOWED_ORIGIN=chrome-extension://pidejkbkldalibjaehjfpjkcpjpcenpk

RELAY_PORT=8787
